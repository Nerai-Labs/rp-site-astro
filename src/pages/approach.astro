---
import BaseLayout from '../layouts/BaseLayout.astro';
import principles from '../data/approach.json';
---

<BaseLayout title="Website Design Process | Jeanine White" description="See how Jeanine approaches your website: customer research, copy before design, and a first version live in four weeks, followed by page-by-page improvements.">
	<div class="stack gap-20">
		<main class="wrapper about">
			<section>
				<h1>How I approach a website</h1>
				<p class="lede">Three principles that keep a project focused on the customers it is for.</p>
			</section>
			{
				principles.map((item) => (
					<section>
						<h2 class="section-title">{item.title}</h2>
						<div class="content">
							<p>{item.text}</p>
						</div>
					</section>
				))
			}
		</main>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@type": "BreadcrumbList",
		"@context": "https://schema.org",
		"itemListElement": [
			{
				"item": "https://nerai-labs.github.io/rp-site-astro/",
				"name": "Home",
				"@type": "ListItem",
				"position": 1
			},
			{
				"item": "https://nerai-labs.github.io/rp-site-astro/approach",
				"name": "Approach",
				"@type": "ListItem",
				"position": 2
			}
		]
	}).replace(/</g, "\\u003c")} />
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}
</style>
